PORT=4000
BACKEND_URL=https://design-engineer.onrender.com

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Settings -> API.
# Example: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Publishable / anon key from Supabase Dashboard -> Settings -> API -> anon public.
# The backend uses it with each user's JWT so row-level security applies.
SUPABASE_PUBLISHABLE_KEY=

# Optional: use SUPABASE_ANON_KEY as an alias for the same value.
# SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# GitHub OAuth (required)
# -----------------------------------------------------------------------------
# Create a GitHub OAuth App at https://github.com/settings/developers
# Homepage URL:            https://design-engineer.onrender.com
# Authorization callback:  https://design-engineer.onrender.com/auth/github/callback
#
# These stay on the backend only — the plugin never sees them. The backend
# "automates" the GitHub login: when a user clicks Connect GitHub, it opens
# GitHub's authorize page with these credentials, exchanges the code, and
# stores the resulting tokens (encrypted) in Supabase.
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# -----------------------------------------------------------------------------
# Encryption key for tokens stored in Supabase (recommended)
# -----------------------------------------------------------------------------
# 32-byte key as 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the same key across backend instances that share Supabase data. Changing
# this key makes existing GitHub/Codex credentials unreadable. If moving an
# existing account's data to a local backend, copy its original key securely.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Optional overrides
# -----------------------------------------------------------------------------
# CODEX_HOME=/app/.codex        # default: <backend>/.codex
# -----------------------------------------------------------------------------
# Razorpay (for payments/upgrade)
# -----------------------------------------------------------------------------
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
