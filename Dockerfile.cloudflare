# STAGING ONLY. Do not expose to untrusted users without isolated jobs.
FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY design-engineer-backend/package*.json ./
RUN npm ci
# Installation must be pinned and tested before production release.
RUN npm install -g @anthropic-ai/claude-code opencode-ai
COPY design-engineer-backend/ ./
ENV PORT=4000
EXPOSE 4000
CMD ["node","server.js"]
