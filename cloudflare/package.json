{
  "name": "design-engineer-cloudflare-containers",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:image": "node scripts/prepare-image.mjs",
    "dev": "npm run prepare:image && wrangler dev",
    "deploy": "npm run prepare:image && wrangler deploy",
    "check:deploy": "npm run prepare:image && wrangler deploy --dry-run --outdir ./dist-check",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.28"
  },
  "devDependencies": {
    "wrangler": "^4.68.0"
  }
}
